/* --- PÁGINA OBRIGADO / UPSELL --- */
.thankyou-body {
  background: #f7f2ec;
  color: #444;
}

.thankyou-hero {
  position: relative;
  width: 100%;
  height: 80vh;
  background-image: url('images/I84A9721.jpg');
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thankyou-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(200, 180, 150, 0.22);
  backdrop-filter: brightness(0.92);
}

.thankyou-hero-text {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #fff;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  padding: 0 18px;
}

.thankyou-hero-text h1 {
  font-size: clamp(28px, 3vw + 10px, 42px);
  margin-bottom: 12px;
  letter-spacing: 0.02em;
}

.thankyou-hero-text p {
  font-size: clamp(16px, 1vw + 12px, 21px);
  margin: 0;
}

.thankyou-upsell {
  max-width: 820px;
  margin: -70px auto 0;
  background: #fff;
  padding: 40px;
  border-radius: 14px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  position: relative;
}

.thankyou-upsell h2 {
  font-size: 28px;
  color: #333;
  margin-bottom: 12px;
}

.thankyou-upsell p {
  font-size: 18px;
  color: #666;
  line-height: 1.7;
  margin-top: 0;
}

.thankyou-offer-title {
  font-size: 24px;
  margin-top: 24px;
  color: #2f241d;
}

.thankyou-benefits {
  background: #faf4ed;
  padding: 18px;
  border-radius: 10px;
  margin-top: 12px;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.thankyou-benefits p {
  margin: 0 0 6px;
  font-size: 17px;
}

.thankyou-cta {
  display: inline-block;
  margin-top: 18px;
  background: #8b5e3c;
  color: #fff;
  padding: 16px 32px;
  border-radius: 8px;
  font-size: 18px;
  text-decoration: none;
  transition: 0.2s;
  box-shadow: 0 12px 25px rgba(139, 94, 60, 0.25);
}

.thankyou-cta:hover {
  background: #744d32;
  transform: translateY(-1px);
}

.thankyou-footer {
  text-align: center;
  margin-top: 28px;
  font-size: 16px;
  color: #777;
  padding: 0 20px 50px;
}

@media (max-width: 720px) {
  .thankyou-hero {
    height: 70vh;
  }

  .thankyou-upsell {
    margin: -50px 16px 0;
    padding: 30px 24px;
  }

  .thankyou-cta {
    width: 100%;
    text-align: center;
  }
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

h1,
h2,
h3,
h4 {
  font-family: 'Playfair Display', serif;
  text-transform: uppercase;
}

